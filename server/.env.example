# Set MONGODB_URI to an Atlas connection string. Leave both values empty for in-memory development.
MONGODB_URI=
# Legacy alias; MONGODB_URI takes precedence when both are set.
MONGO_URI=
JWT_SECRET=change_me_to_a_long_random_string
PORT=5000
# Optional: restrict CORS to your frontend URL in production
CLIENT_URL=
# Set to true to seed demo data into a real database on startup (only if demo user missing)
SEED=false
# Set to production to serve client/dist from the API
NODE_ENV=development
